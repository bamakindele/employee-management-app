POSTGRES_USER=employee_app
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
POSTGRES_DB=employee_management
DATABASE_URL=postgresql+psycopg://employee_app:replace-with-a-long-random-hex-value@localhost:5432/employee_management
JWT_SECRET=replace-with-a-different-long-random-hex-value
VITE_API_URL=http://localhost:8000/api

# PostgreSQL environments can generate and manage JWTs (JSON Web Tokens) in three main ways:
# 1. Using the pgjwt extension (Using Shell: python -c "import secrets; print(secrets.token_hex(32))"
# 2. Using the pgcrypto extension with custom functions
# 3. Using an external service or library to generate and manage JWTs
